class Leaderborder < Formula
  desc "Track AI coding token usage and compete on a leaderboard"
  homepage "https://leaderborder.xaverric.cz"
  url "{{TARBALL_URL}}"
  sha256 "{{TARBALL_SHA256}}"
  license "MIT"

  livecheck do
    url :stable
    strategy :github_latest
  end

  depends_on :macos
  depends_on "node"

  def install
    system "npm", "install", *std_npm_args
    bin.install_symlink libexec.glob("bin/*")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/leaderborder --version")
  end
end
